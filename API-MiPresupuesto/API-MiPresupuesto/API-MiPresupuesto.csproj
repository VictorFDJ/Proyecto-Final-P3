<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>API_MiPresupuesto</RootNamespace>
    <FrontendRoot>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../../Frontend-MiPresupuesto'))</FrontendRoot>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../MiPresupuesto.Application/MiPresupuesto.Application.csproj" />
    <ProjectReference Include="../MiPresupuesto.Infrastructure/MiPresupuesto.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.9">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
  </ItemGroup>

  <Target Name="PublishFrontend"
          BeforeTargets="ComputeFilesToPublish"
          Condition="'$(SkipFrontendBuild)' != 'true'">
    <Exec WorkingDirectory="$(FrontendRoot)" Command="npm ci" />
    <Exec WorkingDirectory="$(FrontendRoot)" Command="npm run build" EnvironmentVariables="VITE_API_URL=/api;VITE_PASSWORD_RESET_ENABLED=false" />
    <ItemGroup>
      <FrontendFiles Include="$(FrontendRoot)/dist/**/*" />
      <ResolvedFileToPublish Include="@(FrontendFiles->'%(FullPath)')">
        <RelativePath>wwwroot/%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>
